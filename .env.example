# --- App ---
APP_ENV=development
APP_PORT=8080

# Port the aura-saku-web dashboard is published on when run via
# `docker compose up` (sibling repo, ../aura-saku-web) — not read by the Go
# backend itself, only by docker-compose.yml's web service.
WEB_PORT=3000

# --- Database (Postgres) ---
# DB_HOST=localhost for native `make run`; docker-compose overrides this to
# "postgres" automatically for the containerized backend service.
DB_HOST=localhost
DB_PORT=5432
DB_USER=aura_saku
DB_PASSWORD=change_me
DB_NAME=aura_saku_db
DB_SSLMODE=disable

# --- Redis ---
# REDIS_HOST=localhost for native `make run`; docker-compose overrides this
# to "redis" automatically for the containerized backend service.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set this instead of the four fields above to use a managed Redis that
# requires TLS (e.g. Upstash's "rediss://default:<password>@<host>:<port>",
# shown on your Upstash dashboard) — it takes priority over RedisHost etc.
# when non-empty. Leave blank for local/Docker Redis.
REDIS_URL=

# --- Telegram ---
# Get a bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL where Telegram will POST updates (use ngrok/cloudflared for local dev).
TELEGRAM_WEBHOOK_URL=
# Random secret string; Telegram echoes it back in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=

# --- AI Provider (pluggable, one of: gemini | openai | anthropic) ---
AI_PROVIDER=gemini

# *_BASE_URL: leave blank to use each client's built-in default. Override
# for Azure OpenAI, Bedrock/Vertex-hosted Claude, a self-hosted
# OpenAI-compatible gateway (LiteLLM/vLLM/Ollama), or a corporate proxy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=
# Anthropic's Messages API version header. Leave blank for the built-in
# default. NOTE: bumping this alone only helps if Anthropic changes the
# version header without changing the response JSON shape — a real schema
# change would still need a code update in internal/ai/anthropic.
ANTHROPIC_API_VERSION=

# --- FX rate provider ---
# Base URL for the live exchange-rate provider (Frankfurter-compatible API).
# Leave blank to use the built-in default. Override here if the provider
# changes domains again (it already has once) without needing a code change.
FX_PROVIDER_BASE_URL=

# --- Guardrails ---
# Caps a text message's length before it's sent to the AI at all, enforced
# in bot.Service (not HTTP middleware) so a rejected message still gets a
# reply. Cost/abuse guardrail, not a product constraint.
MAX_INPUT_CHARS=500
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_MAX_REQUESTS=5
FREE_TIER_DAILY_QUOTA=3
PRO_TIER_DAILY_QUOTA=-1

# --- Earn bonus quota (optional) ---
# Leave REWARD_AFFILIATE_URL blank to disable this feature entirely — no
# reward is ever offered without a real link configured. When set, a
# free-tier user who hits their daily limit is offered this link plus a
# one-time code; /claim <code> grants REWARD_BONUS_AMOUNT extra prompts for
# the day, up to REWARD_MAX_CLAIMS_PER_DAY times. This is an honor-system
# flow (no landing-page verification) — see internal/reward for the caveats.
REWARD_AFFILIATE_URL=
REWARD_BONUS_AMOUNT=3
REWARD_MAX_CLAIMS_PER_DAY=1

# --- Dashboard auth ---
# Signs dashboard session JWTs. REQUIRED — generate with `openssl rand -hex 32`
# and never reuse the same value across environments.
JWT_SECRET=
# How long a session (bot magic-link login or admin login) stays valid.
SESSION_TTL_HOURS=168
# Base URL of the web dashboard (aura-saku-web), used to build the link the
# bot sends via /dashboard. Leave blank and the command replies "not available yet".
DASHBOARD_BASE_URL=

# --- Pro-tier subscription (Midtrans) ---
# Leave both keys blank to disable /subscribe entirely — it replies "not
# available yet" rather than failing outright. Get sandbox keys from
# https://dashboard.sandbox.midtrans.com (Settings > Access Keys) — safe to
# test end-to-end with sandbox test cards / the GoPay/QRIS simulator before
# ever configuring a real production key.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# false = sandbox (default, safe for testing), true = real production charges.
MIDTRANS_IS_PRODUCTION=false
# Separate manual kill switch, independent of whether keys are set above —
# flip to false to pause new /subscribe requests ("not available yet")
# without touching real credentials. Defaults true (so having keys
# configured is enough); both this AND the keys being present are required
# for the feature to actually be available.
MIDTRANS_ACTIVE=true

# Brute-force protection on POST /api/v1/auth/admin-login, keyed by client IP.
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# Guards the session-authenticated dashboard API (transactions/reports/export),
# keyed per effective user ID rather than IP, since dashboard traffic all
# comes from one Next.js server-to-server origin.
DASHBOARD_RATE_LIMIT_WINDOW_SECONDS=60
DASHBOARD_RATE_LIMIT_MAX_REQUESTS=120

# --- Conversation memory ---
# Bounds how much prior conversation is sent to the AI on every call (and
# therefore its token cost) — see internal/service/conversation. Every user
# has one continuous conversation; RECENT_LIMIT is how many of the newest
# messages are always sent verbatim, SUMMARIZE_THRESHOLD is how many
# unsummarized messages accumulate before the oldest are folded into a
# rolling AI-generated summary (must be greater than RECENT_LIMIT).
CONVERSATION_RECENT_LIMIT=10
CONVERSATION_SUMMARIZE_THRESHOLD=20

# --- Misc ---
LOG_LEVEL=debug
